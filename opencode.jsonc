{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "question": "allow",
    "doom_loop": "ask",
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "node --version*": "allow",
      "npm --version*": "allow",
      "pnpm --version*": "allow",
      "yarn --version*": "allow",
      "bun --version*": "allow",
      "ls *": "allow",
      "ls": "allow",
      "dir *": "allow",
      "dir": "allow",
      "cat *": "allow",
      "type *": "allow",
      "echo *": "allow",
      "pwd": "allow",
      "where *": "allow",
      "which *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "mkdir *": "allow",
      "copy *": "allow",
      "cp *": "allow",
      "move *": "allow",
      "mv *": "allow",
      "touch *": "allow",
      "npm run *": "allow",
      "pnpm run *": "allow",
      "yarn run *": "allow",
      "bun run *": "allow",
      "pnpm exec *": "allow",
      "node *": "allow",
      "npx tsc*": "allow",
      "npx eslint*": "allow",
      "npx prettier*": "allow",
      "npx vitest*": "allow",
      "npx jest*": "allow",
      "npx playwright*": "allow",
      "npm ci*": "allow",
      "npm i *": "allow",
      "npm install*": "allow",
      "npm add *": "allow",
      "npm remove *": "allow",
      "npm uninstall*": "allow",
      "npm update*": "allow",
      "npm ls*": "allow",
      "npm view*": "allow",
      "npm outdated*": "allow",
      "npm audit*": "allow",
      "pnpm install*": "allow",
      "pnpm add *": "allow",
      "pnpm remove *": "allow",
      "pnpm update*": "allow",
      "pnpm ls*": "allow",
      "pnpm list*": "allow",
      "pnpm outdated*": "allow",
      "pnpm audit*": "allow",
      "yarn install*": "allow",
      "yarn add *": "allow",
      "yarn remove *": "allow",
      "yarn upgrade*": "allow",
      "yarn list*": "allow",
      "bun install*": "allow",
      "bun add *": "allow",
      "bun remove *": "allow",
      "bun update*": "allow",
      "bun pm ls*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch": "allow",
      "git branch --show-current*": "allow",
      "git branch --list*": "allow",
      "git rev-parse*": "allow",
      "git add*": "allow",
      "git stash*": "allow",
      "git switch*": "allow",
      "git fetch*": "allow",
      "git restore --staged*": "allow",
      "git push*": "deny",
      "git reset*": "deny",
      "git rebase*": "deny",
      "git clean*": "deny",
      "git commit --amend*": "deny",
      "git branch -d*": "deny",
      "git branch -D*": "deny",
      "git branch -m*": "deny",
      "git branch -M*": "deny",
      "git branch -c*": "deny",
      "git branch -C*": "deny",
      "git branch --delete*": "deny",
      "git branch --move*": "deny",
      "git branch --copy*": "deny",
      "rm*": "deny",
      "del*": "deny",
      "rd*": "deny",
      "rmdir*": "deny",
      "Remove-Item*": "deny",
      "format*": "deny",
      "npm install -g*": "deny",
      "npm install --global*": "deny",
      "npm i -g*": "deny",
      "pnpm add -g*": "deny",
      "pnpm install -g*": "deny",
      "yarn global*": "deny",
      "bun add -g*": "deny",
      "npm publish*": "deny",
      "pnpm publish*": "deny",
      "yarn publish*": "deny",
      "bun publish*": "deny"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.6.0",
        "--autoConnect"
      ],
      "enabled": false
    }
  }
}
