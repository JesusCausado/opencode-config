{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "question": "allow",
    "todowrite": "allow",
    "doom_loop": "ask",
    "external_directory": "ask",
    "bash": {
      "*": "ask",

      // Lectura y diagnostico
      "ls": "allow",
      "ls *": "allow",
      "dir": "allow",
      "dir *": "allow",
      "cat *": "allow",
      "type *": "allow",
      "echo *": "allow",
      "pwd": "allow",
      "where *": "allow",
      "which *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "test *": "allow",
      "[ *": "allow",

      // File system seguro
      "mkdir *": "allow",
      "copy *": "allow",
      "cp *": "allow",
      "move *": "allow",
      "mv *": "allow",
      "touch *": "allow",

      // Build y test
      "node *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "py *": "allow",
      "pip *": "allow",
      "pip3 *": "allow",
      "npm run *": "allow",
      "npm exec *": "allow",
      "pnpm run *": "allow",
      "pnpm exec *": "allow",
      "yarn run *": "allow",
      "bun run *": "allow",
      "npx tsc*": "allow",
      "npx eslint*": "allow",
      "npx prettier*": "allow",
      "npx vitest*": "allow",
      "npx jest*": "allow",
      "npx playwright*": "allow",
      "npx ts-node*": "allow",
      "npx nodemon*": "allow",

      // Instalacion npm local
      "npm ci*": "allow",
      "npm install*": "allow",
      "npm add *": "allow",
      "npm remove *": "allow",
      "npm uninstall*": "allow",
      "npm update*": "allow",
      "npm ls*": "allow",
      "npm view*": "allow",
      "npm outdated*": "allow",
      "npm audit*": "allow",
      "pnpm install*": "allow",
      "pnpm add *": "allow",
      "pnpm remove *": "allow",
      "pnpm update*": "allow",
      "pnpm ls*": "allow",
      "pnpm list*": "allow",
      "pnpm outdated*": "allow",
      "pnpm audit*": "allow",
      "yarn add *": "allow",
      "yarn install*": "allow",
      "yarn remove *": "allow",
      "yarn upgrade*": "allow",
      "yarn list*": "allow",
      "yarn audit*": "allow",
      "bun add *": "allow",
      "bun install*": "allow",
      "bun remove *": "allow",
      "bun update*": "allow",
      "bun pm ls*": "allow",

      // Impresion (CUPS / Windows print) - solo si el usuario la pide
      "lp *": "allow",
      "lpstat *": "allow",
      "lpq *": "allow",
      "lprm *": "allow",
      "lpoptions *": "allow",
      "lpr *": "allow",
      "cancel *": "allow",
      "print *": "allow",

      // Git seguro (lectura y ramas)
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch": "allow",
      "git branch -a*": "allow",
      "git branch --list*": "allow",
      "git rev-parse*": "allow",
      "git add*": "allow",
      "git stash*": "allow",
      "git switch*": "allow",
      "git checkout*": "allow",
      "git fetch*": "allow",
      "git restore --staged*": "allow",

      // Git destructivo - DENY
      "git push*": "deny",
      "git reset*": "deny",
      "git rebase*": "deny",
      "git clean*": "deny",
      "git commit --amend*": "deny",
      "git commit --no-verify*": "deny",
      "git commit --reuse-message*": "deny",
      "git commit --author*": "deny",
      "git commit --reset-author*": "deny",
      "git branch -d*": "deny",
      "git branch -D*": "deny",
      "git branch -m*": "deny",
      "git branch -M*": "deny",
      "git branch -c*": "deny",
      "git branch -C*": "deny",
      "git branch --delete*": "deny",
      "git branch --move*": "deny",
      "git branch --copy*": "deny",

      // File system destructivo - DENY
      "rm*": "deny",
      "del*": "deny",
      "rd*": "deny",
      "rmdir*": "deny",
      "Remove-Item*": "deny",
      "format*": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "diskpart*": "deny",

      // Instalacion global y publish - DENY
      "npm install -g*": "deny",
      "npm install --global*": "deny",
      "npm i -g*": "deny",
      "npm publish*": "deny",
      "pnpm add -g*": "deny",
      "pnpm install -g*": "deny",
      "pnpm publish*": "deny",
      "yarn global*": "deny",
      "yarn publish*": "deny",
      "bun add -g*": "deny",
      "bun publish*": "deny",

      // Administracion del sistema - DENY
      "sudo *": "deny",
      "runas *": "deny",
      "net user *": "deny",
      "net localgroup *": "deny",
      "sc *": "deny",
      "reg *": "deny",
      "bcdedit *": "deny",
      "netsh *": "deny",

      // Wrappers de interprete - DENY (evitan bypass)
      "bash -c *": "deny",
      "sh -c *": "deny",
      "zsh -c *": "deny",
      "cmd /c *": "deny",
      "cmd.exe /c *": "deny",
      "powershell -Command *": "deny",
      "powershell.exe -Command *": "deny",
      "pwsh -Command *": "deny",
      "eval *": "deny"
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
      "enabled": false,
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@1.6.0", "--autoConnect"],
      "enabled": false,
    },
  },
  "agent": {
    "frontend": {
      "description": "Especialista en implementacion frontend. Se invoca cuando la tarea involucra componentes UI, estilos, diseño visual, interfaces, estado del cliente, accesibilidad, UX responsive, o cualquier cosa que el usuario ve o interactua directamente.",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "task": "deny",
      },
    },
    "backend": {
      "description": "Especialista en implementacion backend. Se invoca cuando la tarea involucra APIs, servicios, logica de negocio, modelos de datos, autenticacion, integraciones externas, o cualquier cosa del lado del servidor.",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "task": "deny",
      },
    },
    "database": {
      "description": "Especialista en base de datos. Se invoca cuando la tarea involucra queries SQL, stored procedures, migraciones, optimizacion de consultas, indices, o cambios en el esquema de base de datos.",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "task": "deny",
      },
    },
    "build": {
      "description": "Implementador autonomo. Acepta una Historia de Implementacion o una solicitud directa; publica plan y todos, implementa, valida y entrega hallazgos con evidencia.",
      "mode": "primary",
      "color": "#3b82f6",
      "permission": {
        "question": "allow",
        "edit": "allow",
        "todowrite": "allow",
        "bash": {
          "*": "ask",

          // Lectura y diagnostico
          "ls": "allow",
          "ls *": "allow",
          "dir": "allow",
          "dir *": "allow",
          "cat *": "allow",
          "type *": "allow",
          "echo *": "allow",
          "pwd": "allow",
          "where *": "allow",
          "which *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "test *": "allow",
          "[ *": "allow",

          // File system seguro
          "mkdir *": "allow",
          "copy *": "allow",
          "cp *": "allow",
          "move *": "allow",
          "mv *": "allow",
          "touch *": "allow",

          // Build y test
          "node *": "allow",
          "python *": "allow",
          "python3 *": "allow",
          "py *": "allow",
          "pip *": "allow",
          "pip3 *": "allow",
          "npm run *": "allow",
          "npm exec *": "allow",
          "pnpm run *": "allow",
          "pnpm exec *": "allow",
          "yarn run *": "allow",
          "bun run *": "allow",
          "npx tsc*": "allow",
          "npx eslint*": "allow",
          "npx prettier*": "allow",
          "npx vitest*": "allow",
          "npx jest*": "allow",
          "npx playwright*": "allow",
          "npx ts-node*": "allow",
          "npx nodemon*": "allow",

          // Instalacion local
          "npm ci*": "allow",
          "npm install*": "allow",
          "npm add *": "allow",
          "npm remove *": "allow",
          "npm uninstall*": "allow",
          "npm update*": "allow",
          "npm ls*": "allow",
          "npm view*": "allow",
          "npm outdated*": "allow",
          "npm audit*": "allow",
          "pnpm install*": "allow",
          "pnpm add *": "allow",
          "pnpm remove *": "allow",
          "pnpm update*": "allow",
          "pnpm ls*": "allow",
          "pnpm list*": "allow",
          "pnpm outdated*": "allow",
          "pnpm audit*": "allow",
          "yarn add *": "allow",
          "yarn install*": "allow",
          "yarn remove *": "allow",
          "yarn upgrade*": "allow",
          "yarn list*": "allow",
          "yarn audit*": "allow",
          "bun add *": "allow",
          "bun install*": "allow",
          "bun remove *": "allow",
          "bun update*": "allow",
          "bun pm ls*": "allow",

          // Impresion (cuando el usuario la pida)
          "lp *": "allow",
          "lpstat *": "allow",
          "lpq *": "allow",
          "lprm *": "allow",
          "lpoptions *": "allow",
          "lpr *": "allow",
          "cancel *": "allow",
          "print *": "allow",

          // Git lectura
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch": "allow",
          "git branch -a*": "allow",
          "git branch --list*": "allow",
          "git rev-parse*": "allow",
          "git add*": "allow",
          "git stash*": "allow",
          "git switch*": "allow",
          "git switch -c*": "allow",
          "git checkout*": "allow",
          "git fetch*": "allow",
          "git restore --staged*": "allow",

          // DENY
          "rm*": "deny",
          "del*": "deny",
          "rd*": "deny",
          "rmdir*": "deny",
          "Remove-Item*": "deny",
          "format*": "deny",
          "dd *": "deny",
          "mkfs*": "deny",
          "diskpart*": "deny",
          "git push*": "deny",
          "git reset*": "deny",
          "git rebase*": "deny",
          "git clean*": "deny",
          "git commit*": "deny",
          "git branch -d*": "deny",
          "git branch -D*": "deny",
          "git branch -m*": "deny",
          "git branch -M*": "deny",
          "git branch -c*": "deny",
          "git branch -C*": "deny",
          "git branch --delete*": "deny",
          "git branch --move*": "deny",
          "git branch --copy*": "deny",
          "npm install -g*": "deny",
          "npm install --global*": "deny",
          "npm i -g*": "deny",
          "npm publish*": "deny",
          "pnpm add -g*": "deny",
          "pnpm install -g*": "deny",
          "pnpm publish*": "deny",
          "yarn global*": "deny",
          "yarn publish*": "deny",
          "bun add -g*": "deny",
          "bun publish*": "deny",
          "sudo *": "deny",
          "runas *": "deny",
          "net user *": "deny",
          "net localgroup *": "deny",
          "sc *": "deny",
          "reg *": "deny",
          "bcdedit *": "deny",
          "netsh *": "deny",
          "bash -c *": "deny",
          "sh -c *": "deny",
          "zsh -c *": "deny",
          "cmd /c *": "deny",
          "cmd.exe /c *": "deny",
          "powershell -Command *": "deny",
          "powershell.exe -Command *": "deny",
          "pwsh -Command *": "deny",
          "eval *": "deny"
        },
        "task": {
          "frontend": "allow",
          "backend": "allow",
          "database": "allow",
          "security": "allow",
          "review": "allow",
          "explore": "allow",
          "scout": "allow",
          "verify": "allow",
        },
      },
    },
    "commit": {
      "description": "Cierra el ciclo de desarrollo. Analiza cambios, genera mensajes de commit y ejecuta commit solo con autorizacion explicita.",
      "mode": "primary",
      "color": "success",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "bash": {
          "*": "ask",

          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git add *": "allow",
          "git restore --staged *": "allow",
          "git commit*": "allow",

          "git commit --amend*": "deny",
          "git commit --no-verify*": "deny",
          "git commit --reuse-message*": "deny",
          "git commit --author*": "deny",
          "git commit --reset-author*": "deny",
          "git reset*": "deny",
          "git rebase*": "deny",
          "git clean*": "deny",
          "git push*": "deny",
          "git branch -d*": "deny",
          "git branch -D*": "deny",
          "git branch -m*": "deny",
          "git branch -M*": "deny",
          "git branch -c*": "deny",
          "git branch -C*": "deny",
          "git branch --delete*": "deny",
          "git branch --move*": "deny",
          "git branch --copy*": "deny",
        },
      },
    },
    "explore": {
      "description": "Agente de exploracion rapida del codebase. Read-only, especializado en buscar archivos, buscar codigo por patrones, y responder preguntas sobre la estructura del proyecto. Se invoca cuando se necesita entender el codigo existente sin modificarlo.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "bash": "deny",
        "webfetch": "deny",
      },
    },
    "scout": {
      "description": "Agente de investigacion externa. Read-only, especializado en investigar documentacion de librerias, dependencias, y codigo fuente upstream. Se invoca cuando se necesita entender como funciona una libreria externa o dependencia sin modificar el workspace.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "bash": "deny",
      },
    },
  },
}
