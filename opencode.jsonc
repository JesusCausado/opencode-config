{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],

  // Modelo de permisos: autonomia por defecto, deny explicito para lo
  // destructivo o externo. Las reglas se encadenan global -> agente y gana
  // la ULTIMA que coincide: un agente que redefina "*" anula estos deny y
  // debe repetir los que necesite (commit, verify y security lo hacen con
  // "*": deny + allowlist propia).
  //
  // "deny" en vez de "ask" es intencional: un deny no bloquea la sesion,
  // el agente recibe el rechazo y busca otra via. Asi Build termina solo.
  "permission": {
    "question": "allow",
    "todowrite": "allow",
    "doom_loop": "deny", // corta bucles en vez de quedarse esperando
    // "allow": un deny/ask aqui queda despues de los allow automaticos de
    // skills y las bloquearia; ademas bash ya puede salir del repo.
    "external_directory": "allow",
    "edit": "ask", // cada agente que edita declara edit: allow

    "bash": {
      "*": "allow",

      // DENY: git de historial y ramas
      "git -C *": "deny",
      "git push*": "deny",
      "git commit*": "deny", // solo el agente commit lo habilita
      "git reset*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git clean*": "deny",
      "git filter-branch*": "deny",
      "git update-ref*": "deny",
      "git reflog expire*": "deny",
      "git gc --prune*": "deny",
      "git stash drop*": "deny",
      "git stash clear*": "deny",
      "git checkout -- *": "deny",
      "git checkout .": "deny",
      "git restore*": "deny",
      "git restore --staged*": "allow",
      "git tag -d*": "deny",
      "git branch -d*": "deny",
      "git branch -D*": "deny",
      "git branch -m*": "deny",
      "git branch -M*": "deny",
      "git branch -c*": "deny",
      "git branch -C*": "deny",
      "git branch --delete*": "deny",
      "git branch --move*": "deny",
      "git branch --copy*": "deny",

      // DENY: destructivos de disco
      "rm*": "deny",
      "del*": "deny",
      "erase *": "deny",
      "rd*": "deny",
      "rmdir*": "deny",
      "Remove-Item*": "deny",
      "ri *": "deny",
      "format*": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "diskpart*": "deny",
      "cipher /w*": "deny",

      // DENY: instalacion global y publish
      "npm install -g*": "deny",
      "npm install --global*": "deny",
      "npm i -g*": "deny",
      "npm publish*": "deny",
      "pnpm add -g*": "deny",
      "pnpm install -g*": "deny",
      "pnpm publish*": "deny",
      "yarn global*": "deny",
      "yarn publish*": "deny",
      "bun add -g*": "deny",
      "bun publish*": "deny",
      "choco *": "deny",
      "winget *": "deny",
      "scoop *": "deny",

      // DENY: administracion del sistema
      "sudo *": "deny",
      "runas *": "deny",
      "net user *": "deny",
      "net localgroup *": "deny",
      "sc *": "deny",
      "reg *": "deny",
      "bcdedit *": "deny",
      "netsh *": "deny",
      "shutdown*": "deny",
      "Stop-Computer*": "deny",
      "Restart-Computer*": "deny",
      "Set-ExecutionPolicy*": "deny",
      "Start-Process*": "deny",

      // DENY: efectos externos / produccion
      "ssh *": "deny",
      "scp *": "deny",
      "gh pr merge*": "deny",
      "gh release*": "deny",
      "gh repo delete*": "deny",
      "docker rm*": "deny",
      "docker rmi*": "deny",
      "docker volume rm*": "deny",
      "docker system prune*": "deny",
      "kubectl apply*": "deny",
      "kubectl delete*": "deny",
      "terraform apply*": "deny",
      "terraform destroy*": "deny",
      "dropdb*": "deny",

      // DENY: wrappers de interprete (evitan bypass)
      "bash -c *": "deny",
      "sh -c *": "deny",
      "zsh -c *": "deny",
      "cmd /c *": "deny",
      "cmd.exe /c *": "deny",
      "powershell -c*": "deny",
      "powershell -e*": "deny",
      "powershell.exe -c*": "deny",
      "powershell.exe -e*": "deny",
      "pwsh -c*": "deny",
      "pwsh -e*": "deny",
      "Invoke-Expression*": "deny",
      "iex *": "deny",
      "eval *": "deny"
    }
  },

  // Modelos: sin "model" los subagentes heredan el del agente primario que
  // los invoca; cambiar el modelo de la sesion de Build (/models) cambia
  // todo el pipeline. Para fijar uno: "model": "<proveedor>/<modelo>" en el
  // frontmatter del agente (ver `opencode models`).

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@1.6.0", "--autoConnect"],
      "enabled": false
    }
  }
}
