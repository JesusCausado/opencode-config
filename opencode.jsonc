{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],

  "permission": {
    "question": "allow",
    "todowrite": "allow",
    "doom_loop": "ask",
    "external_directory": "ask",
    "edit": "ask",

    "bash": {
      "*": "ask",

      // Lectura y diagnostico
      "ls": "allow",
      "ls *": "allow",
      "dir": "allow",
      "dir *": "allow",
      "cat *": "allow",
      "type *": "allow",
      "echo *": "allow",
      "pwd": "allow",
      "where *": "allow",
      "which *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "test *": "allow",
      "[ *": "allow",

      // Busquedas y diagnostico en archivos (PowerShell)
      "Select-String*": "allow",
      "Get-Content*": "allow",
      "Get-ChildItem*": "allow",
      "Get-Item*": "allow",
      "Get-Location*": "allow",
      "Get-Command*": "allow",
      "Get-Help*": "allow",
      "Get-Process*": "allow",
      "Get-Variable*": "allow",
      "Get-Date*": "allow",
      "Write-Output*": "allow",
      "Write-Host*": "allow",
      "Format-Table*": "allow",
      "Format-List*": "allow",
      "Out-String*": "allow",
      "Out-Null*": "allow",
      "Sort-Object*": "allow",
      "Where-Object*": "allow",
      "ForEach-Object*": "allow",
      "Group-Object*": "allow",
      "Select-Object*": "allow",
      "Measure-Object*": "allow",
      "Compare-Object*": "allow",
      "ConvertTo-Json*": "allow",
      "ConvertFrom-Json*": "allow",
      "Resolve-Path*": "allow",
      "Measure-Command*": "allow",
      "Find-Item*": "allow",
      "Find-Str*": "allow",

      // Busqueda de contenido (CLI)
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",

      // File system seguro
      "mkdir *": "allow",
      "copy *": "allow",
      "cp *": "allow",
      "move *": "allow",
      "mv *": "allow",
      "touch *": "allow",
      // File system PowerShell (cmdlets equivalentes a mv/cp/rename)
      "Move-Item *": "allow",
      "Rename-Item *": "allow",
      "Copy-Item *": "allow",

      // Runtimes de proyecto
      "node *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "py *": "allow",
      "pip *": "allow",
      "pip3 *": "allow",
      "dotnet *": "allow",
      "go *": "allow",
      "cargo *": "allow",
      "gradle *": "allow",
      "mvn *": "allow",
      "flutter *": "allow",
      "dart *": "allow",
      "swift *": "allow",
      "xcodebuild *": "allow",

      // Scripts de proyecto
      "npm run *": "allow",
      "npm exec *": "allow",
      "npm test*": "allow",
      "pnpm run *": "allow",
      "pnpm exec *": "allow",
      "pnpm dlx *": "allow",
      "pnpm test*": "allow",
      "yarn run *": "allow",
      "yarn test*": "allow",
      "bun run *": "allow",
      "bun test*": "allow",

      // Validadores y herramientas via npx
      "npx tsc*": "allow",
      "npx eslint*": "allow",
      "npx prettier*": "allow",
      "npx vitest*": "allow",
      "npx jest*": "allow",
      "npx playwright*": "allow",
      "npx ts-node*": "allow",
      "npx nodemon*": "allow",
      "npx next*": "allow",
      "npx vite*": "allow",
      "npx astro*": "allow",
      "npx remix*": "allow",
      "npx prisma*": "allow",
      "npx drizzle-kit*": "allow",
      "npx tsup*": "allow",
      "npx tailwind*": "allow",
      "npx shadcn*": "allow",

      // Instalacion npm local
      "npm ci*": "allow",
      "npm install*": "allow",
      "npm i *": "allow",
      "npm add *": "allow",
      "npm remove *": "allow",
      "npm uninstall*": "allow",
      "npm update*": "allow",
      "npm ls*": "allow",
      "npm view*": "allow",
      "npm outdated*": "allow",
      "npm audit*": "allow",
      "pnpm install*": "allow",
      "pnpm add *": "allow",
      "pnpm remove *": "allow",
      "pnpm update*": "allow",
      "pnpm ls*": "allow",
      "pnpm list*": "allow",
      "pnpm outdated*": "allow",
      "pnpm audit*": "allow",
      "yarn add *": "allow",
      "yarn install*": "allow",
      "yarn remove *": "allow",
      "yarn upgrade*": "allow",
      "yarn list*": "allow",
      "yarn audit*": "allow",
      "bun add *": "allow",
      "bun install*": "allow",
      "bun remove *": "allow",
      "bun update*": "allow",
      "bun pm ls*": "allow",

      // CLIs de base de datos (lectura y diagnostico)
      "psql *": "allow",
      "mysql *": "allow",
      "sqlite3 *": "allow",
      "mongo *": "allow",
      "mongosh *": "allow",
      "redis-cli *": "allow",
      "docker ps*": "allow",
      "docker logs*": "allow",

      // Impresion (solo si el usuario la pide)
      "lp *": "allow",
      "lpstat *": "allow",
      "lpq *": "allow",
      "lprm *": "allow",
      "lpoptions *": "allow",
      "lpr *": "allow",
      "cancel *": "allow",
      "print *": "allow",

      // Git seguro (lectura y ramas)
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch": "allow",
      "git branch -a*": "allow",
      "git branch --list*": "allow",
      "git rev-parse*": "allow",
      "git add*": "allow",
      "git stash*": "allow",
      "git switch*": "allow",
      "git checkout*": "allow",
      "git fetch*": "allow",
      "git restore --staged*": "allow",

      // DENY: destructivos
      "rm*": "deny",
      "del*": "deny",
      "rd*": "deny",
      "rmdir*": "deny",
      "Remove-Item*": "deny",
      "format*": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "diskpart*": "deny",

      // DENY: git destructivo y externo
      "git push*": "deny",
      "git reset*": "deny",
      "git rebase*": "deny",
      "git clean*": "deny",
      "git commit --amend*": "deny",
      "git commit --no-verify*": "deny",
      "git commit --reuse-message*": "deny",
      "git commit --author*": "deny",
      "git commit --reset-author*": "deny",
      "git branch -d*": "deny",
      "git branch -D*": "deny",
      "git branch -m*": "deny",
      "git branch -M*": "deny",
      "git branch -c*": "deny",
      "git branch -C*": "deny",
      "git branch --delete*": "deny",
      "git branch --move*": "deny",
      "git branch --copy*": "deny",

      // DENY: instalacion global y publish
      "npm install -g*": "deny",
      "npm install --global*": "deny",
      "npm i -g*": "deny",
      "npm publish*": "deny",
      "pnpm add -g*": "deny",
      "pnpm install -g*": "deny",
      "pnpm publish*": "deny",
      "yarn global*": "deny",
      "yarn publish*": "deny",
      "bun add -g*": "deny",
      "bun publish*": "deny",

      // DENY: administracion del sistema
      "sudo *": "deny",
      "runas *": "deny",
      "net user *": "deny",
      "net localgroup *": "deny",
      "sc *": "deny",
      "reg *": "deny",
      "bcdedit *": "deny",
      "netsh *": "deny",

      // DENY: wrappers de interprete (evitan bypass)
      "bash -c *": "deny",
      "sh -c *": "deny",
      "zsh -c *": "deny",
      "cmd /c *": "deny",
      "cmd.exe /c *": "deny",
      "powershell -Command *": "deny",
      "powershell.exe -Command *": "deny",
      "pwsh -Command *": "deny",
      "eval *": "deny"
    }
  },

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@1.6.0", "--autoConnect"],
      "enabled": false
    }
  }
}
